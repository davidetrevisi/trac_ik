<?xml version="1.0"?>
<!-- FIXTURE (implementation ticket 06). A chain with a PLANAR joint in it, which is the refusal
     nothing else in the suite can reach. kdl_parser has no planar joint: it converts j2 to a fixed
     one, so the KDL chain has two joint variables while the URDF has three movable joints. Index i
     then means a different joint on the two sides of the plugin's seam -- and the solver joint list
     would be longer than the configuration MoveIt writes a solution back into, which is how a
     kinematics plugin corrupts memory in a release build.

     MoveIt gives a planar joint three variables, so the plugin refuses the robot and names j2.
     Box geometry only, not a model of any real robot. -->
<robot name="planar_arm">
  <link name="base_link">
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry></visual>
  </link>

  <link name="shoulder_link">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="100" velocity="2.0"/>
  </joint>

  <link name="slide_link">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
  </link>
  <joint name="j2" type="planar">
    <parent link="shoulder_link"/><child link="slide_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="100" velocity="2.0"/>
  </joint>

  <link name="tool_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
  </link>
  <joint name="j3" type="revolute">
    <parent link="slide_link"/><child link="tool_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="50" velocity="2.0"/>
  </joint>
</robot>
